{
  "name": "road-rash-computer-vision-game",
  "private": true,
  "version": "1.0.0",
  "description": "Road Rash inspired computer vision game with real-time hand tracking.",
  "author": "ENiGMA-101",
  "type": "module",

  "main": "electron/main.cjs",

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",

    "electron": "electron .",

    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",

    "dist": "npm run build && electron-builder"
  },

  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },

  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^9.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "wait-on": "^9.0.0"
  },

  "build": {
  "appId": "com.enigma101.roadrashcv",
  "productName": "Road Rash Computer Vision Game",

  "directories": {
    "output": "release"
  },

  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],

  "win": {
    "target": "nsis",
    "icon": "build/road-rash.ico"
  },

  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
}